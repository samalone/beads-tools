{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] && mkdir -p \"$HOME/.local/bin\" && ln -sf \"${CLAUDE_PLUGIN_ROOT}/bin/bd-mode\" \"$HOME/.local/bin/bd-mode\" || true"
          }
        ]
      }
    ]
  }
}
